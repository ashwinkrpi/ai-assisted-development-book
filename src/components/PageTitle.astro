---
// Starlight's page title with a "book / <chapter>" breadcrumb above it. The chapter is the
// page's title; the home page shows only "book".
import network from '../../network.json';

const { entry, id } = Astro.locals.starlightRoute;
const book = network.sites.find((s) => s.id === 'book');
const isHome = id === '' || id === 'index';
const home = import.meta.env.BASE_URL;
---

<nav class="crumbs" aria-label="Breadcrumb">
	<ol>
		<li>
			{isHome ? <span aria-current="page">{book?.label ?? 'book'}</span> : <a href={home}>{book?.label ?? 'book'}</a>}
		</li>
		{!isHome && <li><span aria-current="page">{entry.data.title}</span></li>}
	</ol>
</nav>
<h1 id="_top">{entry.data.title}</h1>

<style>
	@layer starlight.core {
		h1 {
			margin-top: 0.5rem;
			font-size: var(--sl-text-h1);
			line-height: var(--sl-line-height-headings);
			font-weight: 600;
			color: var(--sl-color-white);
		}
	}
	.crumbs {
		margin-top: 1rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.crumbs ol {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.crumbs li + li::before {
		content: '/';
		margin-inline-end: 0.25rem;
	}
	.crumbs a {
		color: var(--sl-color-text-accent);
		text-decoration: none;
	}
	.crumbs a:hover {
		text-decoration: underline;
	}
</style>
