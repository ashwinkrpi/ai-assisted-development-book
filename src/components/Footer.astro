---
// Starlight's footer (edit link, last updated, previous/next), then the shared Somaari footer (markup from
// somaari-common's footer.mjs, copied into public/theme/ by scripts/sync-common.sh; styles from
// /theme/footer.css, linked in Head.astro), then the book's licence line. Starlight has no option for footer
// text, so Footer is overridden. Change the shared footer in somaari-common, not here.
import Default from '@astrojs/starlight/components/Footer.astro';
import network from '../../network.json';
import { footer } from '../../public/theme/footer.mjs';
---

<Default><slot /></Default>
<Fragment set:html={footer(network)} />
<p class="book-licence">
	Book content licensed under
	<a href="https://creativecommons.org/licenses/by-nc-sa/4.0/">CC BY-NC-SA 4.0</a>; code under MIT.
	<a href="https://github.com/ashwinkrpi/ai-assisted-development-book/blob/main/LICENSE">License details</a>.
</p>

<style>
	.book-licence {
		margin: 0.75rem 0 0;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
	}
	.book-licence a {
		color: var(--sl-color-text-accent);
	}
</style>
