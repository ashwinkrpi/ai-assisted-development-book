---
// Replaces Starlight's ThemeProvider (LT-01). Sets <html data-theme> to a somaari theme id before
// first paint, with the logic of somaari-common theme/theme.js: ?theme=<id> preview (never saved),
// else localStorage "somaari-theme", else the seasonal schedule in IST, else the default. Without
// JavaScript there is no data-theme and the :root tokens (warm-tactile) apply.
//
// It also inlines the somaari tokens, taken from the vendored copies at build time so that
// `npm run sync:common` is the only place they change:
//   - themes.css without its @font-face rules and --font/--font-display (the fonts are registered
//     in astro.config.mjs; Astro owns --font-display);
//   - --theme-color per theme, from THEMES[id].color in theme.js.
// src/styles/somaari.css maps these tokens onto Starlight's --sl-color-* variables.
import themesCss from '../../vendor/somaari-common/theme/themes.css?raw';
import themeJs from '../../vendor/somaari-common/theme/theme.js?raw';
import themeData from '../data/themes.json';

// theme.js exports its data when `module` exists and returns before touching `document`.
const shared = { exports: {} as { THEMES?: Record<string, { color: string }> } };
new Function('module', themeJs)(shared);
const colors = shared.exports.THEMES ?? {};

const { defaultTheme, themes, schedule } = themeData;
const ids = Object.keys(themes);

const tokens = themesCss
	.replace(/\/\*[\s\S]*?\*\//g, '')
	.replace(/@font-face\s*\{[^}]*\}/g, '')
	.replace(/^\s*--font(-display)?:[^;]*;\s*$/gm, '')
	.replace(/\n\s*\n/g, '\n')
	.trim();

const themeColors = ids
	.filter((id) => colors[id])
	.map((id) => {
		const selector = id === defaultTheme ? `:root,:root[data-theme="${id}"]` : `:root[data-theme="${id}"]`;
		return `${selector}{--theme-color:${colors[id].color}}`;
	})
	.join('\n');

const config = { ids, defaultTheme, schedule, colors };
---

<style is:inline set:html={`${tokens}\n${themeColors}`}></style>
<script is:inline define:vars={{ config }}>
	(function () {
		var STORAGE_KEY = 'somaari-theme';
		var IST_OFFSET_MS = 330 * 60 * 1000; // UTC+5:30; India has no daylight saving
		var root = document.documentElement;

		function isTheme(id) {
			return config.ids.indexOf(id) !== -1;
		}

		// The schedule's theme for the instant `date`, judged by the calendar day in India.
		function getDefaultTheme(date) {
			var ymd = new Date(date.getTime() + IST_OFFSET_MS).toISOString().slice(0, 10);
			var md = ymd.slice(5);
			for (var i = 0; i < config.schedule.length; i++) {
				var e = config.schedule[i];
				if (e.from && ymd >= e.from && ymd <= e.to) return e.theme;
				if (e.monthDay) {
					var a = e.monthDay[0];
					var b = e.monthDay[1];
					if (a <= b ? md >= a && md <= b : md >= a || md <= b) return e.theme; // b < a wraps the new year
				}
			}
			return config.defaultTheme;
		}

		function readSaved() {
			try {
				var v = localStorage.getItem(STORAGE_KEY);
				return isTheme(v) ? v : null;
			} catch (e) {
				return null;
			}
		}

		function save(id) {
			try {
				if (id) localStorage.setItem(STORAGE_KEY, id);
				else localStorage.removeItem(STORAGE_KEY);
			} catch (e) {
				/* storage blocked: the choice lasts for this page view only */
			}
		}

		function readPreview() {
			try {
				var v = new URLSearchParams(location.search).get('theme');
				return isTheme(v) ? v : null;
			} catch (e) {
				return null;
			}
		}

		function apply(id) {
			root.setAttribute('data-theme', id);
			var metas = document.querySelectorAll('meta[name="theme-color"]');
			for (var i = 0; i < metas.length; i++) {
				if (config.colors[id]) metas[i].setAttribute('content', config.colors[id].color);
			}
			var ev;
			try {
				ev = new CustomEvent('somaari-theme', { detail: { id: id } });
			} catch (e) {
				return;
			}
			root.dispatchEvent(ev);
		}

		var preview = readPreview();
		var saved = readSaved();
		apply(preview || saved || getDefaultTheme(new Date()));

		// Used by src/components/ThemeSelect.astro.
		window.SomaariTheme = {
			// "auto", or the theme id that was previewed or saved.
			choice: function () {
				return preview || saved || 'auto';
			},
			// Save a theme id, or clear the saved one with "auto", and apply the result.
			choose: function (value) {
				saved = isTheme(value) ? value : null;
				save(saved);
				apply(saved || getDefaultTheme(new Date()));
				// A choice replaces any ?theme= preview, so it is what shows after a reload.
				if (preview) {
					preview = null;
					try {
						var url = new URL(location.href);
						url.searchParams.delete('theme');
						history.replaceState(null, '', url);
					} catch (e) {
						/* leave the URL as it is */
					}
				}
			},
		};
	})();
</script>
