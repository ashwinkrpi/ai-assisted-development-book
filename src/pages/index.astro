---
// The book site's home page: one card per book, styled like the app cards on somaari.in (same
// tokens from somaari-common's themes.css). To add a book, add an entry to src/data/books.json.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import books from '../data/books.json';

const description = 'Free books on building useful software with AI assistance, by Ashwin Koppam Raghavendra.';
const label = { live: 'Available', dev: 'In development', soon: 'Coming soon' };
---

<StarlightPage
	frontmatter={{ title: 'Books', description, template: 'splash', editUrl: false, lastUpdated: false, pagefind: false }}
>
	<div class="books">
		<section class="books-hero" aria-labelledby="books-heading">
			<h2 id="books-heading">Free books on building with AI.</h2>
			<p class="books-sub">
				Practical, open books on using AI tools to write software without giving up engineering judgment.
				Read them online, free.
			</p>
		</section>

		<ul class="card-grid" role="list">
			{
				books.map((b) => (
					<li class={`card${b.status === 'live' ? '' : ' card--dev'}`}>
						<div class="card-head">
							<div class="card-names">
								<h3 class="card-title">
									<a href={b.href}>{b.title}{b.volume && ` — ${b.volume}`}</a>
								</h3>
								{b.subtitle && <p class="card-sub">{b.subtitle}</p>}
							</div>
							<span class={`badge badge--${b.status}`}>{label[b.status]}</span>
						</div>
						<p class="card-desc">{b.description}</p>
						{b.meta && <p class="card-meta">{b.meta}</p>}
						<p class="card-actions">
							<a class="btn" href={b.href}>Read the book</a>
							{b.start && <a class="btn btn--secondary" href={b.start.href}>{b.start.label}</a>}
						</p>
					</li>
				))
			}
		</ul>
		<p class="books-more">More volumes and books are planned. Follow along on the <a href="https://blog.somaari.in/">blog</a>.</p>
	</div>
</StarlightPage>

<style>
	.books {
		max-width: 64rem;
		margin-inline: auto;
	}
	.books-hero h2 {
		margin: 0;
		font-size: var(--text-hero);
		letter-spacing: -0.02em;
		max-width: 40rem;
	}
	.books-sub {
		margin: 1rem 0 2rem;
		max-width: 52rem;
		color: var(--muted);
		font-size: var(--text-lg);
	}
	.card-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1.5rem;
		grid-template-columns: 1fr;
	}
	@media (min-width: 40rem) {
		.card-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	.card {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		min-width: 0;
		margin: 0;
		padding: 1.25rem;
		background: var(--card-bg);
		color: var(--fg);
		border: 1px solid var(--card-edge, var(--line));
		border-top: var(--card-top, 1px) solid var(--card-top-color, var(--card-edge, var(--line)));
		border-radius: var(--card-radius);
		box-shadow: var(--shadow);
		transition: transform 0.15s ease, box-shadow 0.15s ease;
	}
	.card--dev {
		border-style: dashed;
		border-top-style: solid;
	}
	.card:hover,
	.card:focus-within {
		transform: translateY(-2px);
		box-shadow: var(--shadow-hover);
	}
	@media (prefers-reduced-motion: reduce) {
		.card {
			transition: none;
		}
		.card:hover,
		.card:focus-within {
			transform: none;
		}
	}
	.card-head {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.5rem;
	}
	.card-names {
		min-width: 0;
	}
	.card-title {
		margin: 0;
		font-size: 1.3rem;
	}
	.card-title a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		color: var(--card-title, var(--fg));
		text-decoration: none;
	}
	.card-title a:hover {
		color: var(--card-title-hover, var(--accent));
		text-decoration: underline;
	}
	.card-sub,
	.card-meta {
		margin: 0.1rem 0 0;
		font-size: 0.88rem;
		color: var(--subtle);
	}
	.card-desc {
		margin: 0;
		color: var(--muted);
		flex: 1;
	}
	.badge {
		display: inline-block;
		padding: 0.1rem 0.6rem;
		border: 1px solid currentColor;
		border-radius: 999px;
		font-size: var(--text-2xs);
		font-weight: 600;
		white-space: nowrap;
	}
	.badge--live {
		color: var(--status, var(--accent));
	}
	.badge--dev {
		color: var(--subtle);
		border-style: dashed;
	}
	.badge--soon {
		color: var(--subtle);
		border-style: dotted;
	}
	.card-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0;
	}
	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 44px;
		padding: 0.4rem 1.1rem;
		border: 1px solid var(--accent);
		border-radius: var(--btn-radius);
		background: var(--accent);
		color: var(--on-accent);
		font-weight: 600;
		text-decoration: none;
	}
	.btn:hover {
		background: var(--accent-hover);
		border-color: var(--accent-hover);
		color: var(--on-accent);
	}
	.btn--secondary {
		background: transparent;
		color: var(--accent);
	}
	.btn--secondary:hover {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--on-accent);
	}
	.books-more {
		margin: 2rem 0 0;
		color: var(--muted);
	}
</style>
